# Copy this file to .env. Never commit the real .env file.
LST_LOG_LEVEL=INFO
LST_TARGET_LANGUAGE=VI
LST_SOURCE_LANGUAGE=auto
LST_TRANSLATION_PROVIDER=offline
LST_CAPTURE_INTERVAL_MS=750
LST_OCR_DEBOUNCE_MS=650
LST_CHANGE_THRESHOLD=0.035
LST_OCR_CONFIDENCE_THRESHOLD=0.65
LST_MONITOR_INDEX=0
LST_OCR_USE_GPU=false

# Global Windows hotkeys
LST_HOTKEY_TOGGLE=Ctrl+Alt+T
LST_HOTKEY_PAUSE=Ctrl+Alt+P
LST_HOTKEY_RETRANSLATE=Ctrl+Alt+R
LST_HOTKEY_OVERLAY=Ctrl+Alt+H

# Optional online providers. Keys are never written to settings.json.
# LST_DEEPL_API_KEY=
# LST_GOOGLE_API_KEY=

